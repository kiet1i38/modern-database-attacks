# Docker Compose supplies all required environment values; no .env is needed.
# These are PUBLIC SYNTHETIC LOCAL-LAB defaults, not production secrets.
VARIANT=mongo-safe
LAB_LOCAL_ONLY=true
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
SESSION_SECRET=mongo-safe-local-session-secret-not-for-production
MONGODB_URI=mongodb://mongodb:27017
MYSQL_HOST=mysql
MYSQL_USER=campus
MYSQL_PASSWORD=campus-local-demo-only
# Docker Compose applies these only to the two unsafe services.
CAMPUS_SQL_STACKED_LAB=true
CAMPUS_SQL_LAB_URL=mysql://campus_lab:campus-lab-local-demo-only@mysql:3306/campus_sql_unsafe_lab
CAMPUS_MONGO_DELETE_LAB=true
CAMPUS_MONGO_LAB_URI=mongodb://mongodb:27017/campus_mongo_unsafe_lab
