{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": { "maxDuration": 30 }
  },
  "routes": [
    {
      "src": "/.*",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "no-referrer",
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'"
      },
      "continue": true
    },
    { "src": "/api(/.*)?", "dest": "/api/index.js" },
    { "handle": "filesystem" },
    { "src": "/docs", "dest": "/docs/index.html" },
    { "src": "/(assets|docs|evidence)(/.*)?", "status": 404 },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
