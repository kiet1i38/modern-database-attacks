{
  "name": "modern-database-attacks",
  "version": "1.0.0",
  "private": true,
  "description": "CampusDesk: four isolated SQL/NoSQL authentication labs with dashboards and roles",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "start": "node src/campus/server.js",
    "build": "tsc -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "build:presentation": "npm run build -- --mode presentation",
    "build:vercel": "npm run build && node scripts/build-vercel.js",
    "seed": "node scripts/campus-seed.js",
    "db:up": "docker compose up -d mysql mongodb",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mysql mongodb",
    "db:reset": "node scripts/campus-seed.js --reset --yes",
    "db:prepare:hosted": "node scripts/prepare-hosted-db.js",
    "test": "node --test tests/campus/unit.test.js tests/campus/auth.test.js tests/campus/hosted.test.js",
    "test:legacy": "node --test tests/unit/validation.test.js tests/unit/password.test.js tests/security/routes.test.js",
    "test:integration": "node scripts/test-campus-api.js",
    "test:all": "npm test && npm run test:integration"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/themes": "^3.3.0",
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "mongodb": "^6.21.0",
    "mysql2": "^3.24.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
